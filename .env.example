# Gigster environment variables.
# Copy to apps/web/.env.local and apps/backend/.env (see docs/06-conventions.md).

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (web, client + server) ---
NEXT_PUBLIC_SUPABASE_URL=https://uyhicdgnaairxuvwfaoo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
